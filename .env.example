# --- Google OAuth（NextAuth用。Google Cloud ConsoleでOAuthクライアントを作成） ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- サイト（SEO） ---
# 本番の公開URL。canonical・OGP・sitemapの絶対URLの基点になる。
# 未設定のまま本番に出すとlocalhostを指すURLが検索エンジンに渡るので必ず設定する
NEXT_PUBLIC_SITE_URL=

# --- NextAuth ---
# openssl rand -base64 32 で生成
NEXTAUTH_SECRET=

# --- バックエンド ---
# 自前JWTの署名鍵。openssl rand -hex 32 で生成
SECRET_KEY=
# Monlix契約後に設定。それまでは空でよい
MONLIX_POSTBACK_SECRET=

# --- CPALead（オファーウォール） ---
# 契約前はtrueのままにする。サーバー内のモックが本物のCPALead APIの代わりに応答する。
# 契約後はfalseにして下の3つを実際の値で埋める（falseのまま未設定だとポストバックは全て拒否される）
CPALEAD_MOCK=true
CPALEAD_API_KEY=
CPALEAD_POSTBACK_SECRET=
# ポストバックの送信元IP（カンマ区切り）。CPALeadのダッシュボードで確認して設定する
CPALEAD_ALLOWED_IPS=

# --- Reloadly（Reloadly developerダッシュボードで取得。ポイント→携帯キャリアチャージ交換用） ---
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=

# --- Appwrite Storage（記事のアイキャッチ画像。GitHub Student PackのPro相当） ---
# Appwriteコンソールでプロジェクトとバケットを作り、Storageの読み書き権限を持つAPIキーを発行する。
# バケットは「公開読み取り」にしておくこと（記事の画像をブラウザから直接見るため）
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=papunto-media
