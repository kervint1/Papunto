# ローカル開発用。本番の値はVercel／Herokuの環境変数に入れる（docs/requirements/07-deployment.md）

# --- Google OAuth（NextAuth用。Google Cloud ConsoleでOAuthクライアントを作成） ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth ---
# openssl rand -base64 32 で生成
NEXTAUTH_SECRET=

# --- サイト（SEO） ---
# 公開URL。canonical・OGP・sitemapの絶対URLの基点になる。
# 未設定のまま本番に出すとlocalhostを指すURLが検索エンジンに渡るので必ず設定する
NEXT_PUBLIC_SITE_URL=

# メディアサイト（別リポジトリ papunto-pandia）のURL。設定すると /blog がそちらへ転送される。
# ローカルで /blog 経由の確認をしないなら空でよい（pandiaを直接 :3002 で開けば見られる）
# 例（Docker内からホストを見るため localhost ではない）: http://host.docker.internal:3002
MEDIA_URL=

# --- バックエンド ---
# 自前JWTの署名鍵。openssl rand -hex 32 で生成
SECRET_KEY=
# APIの公開URL。ポストバックURLとCPALeadモックの基点。本番はHerokuアプリのURL
PUBLIC_BASE_URL=http://localhost:8000
# Monlix契約後に設定。それまでは空でよい
MONLIX_POSTBACK_SECRET=

# --- 事前登録キャンペーン ---
# 先着の枠数。100名で始めて、順調なら増やす（設定変更だけで済ませる）
CAMPAIGN_SLOT_LIMIT=100
# 枠内の登録者に付与する報酬（500pt = S/ 5 = 最低換金額と同じ）
CAMPAIGN_REWARD_POINTS=500
# 換金の開放日（YYYY-MM-DD）。事前登録の期間中は交換させない。
# ⚠️ 空にすると即座に開放される。LPで告知した日付と必ず一致させること
WITHDRAWALS_OPEN_AT=

# --- CPALead（オファーウォール） ---
# 契約前はtrueのままにする。サーバー内のモックが本物のCPALead APIの代わりに応答する。
# 契約後はfalseにして下の3つを実際の値で埋める（falseのまま未設定だとポストバックは全て拒否される）
CPALEAD_MOCK=true
CPALEAD_API_KEY=
CPALEAD_POSTBACK_SECRET=
# ポストバックの送信元IP（カンマ区切り）。CPALeadのダッシュボードで確認して設定する
CPALEAD_ALLOWED_IPS=

# --- Reloadly（ポイント→携帯キャリアチャージ交換用） ---
# サンドボックスは「成功」を返すだけで実際にはチャージされない。
# 本番でサンドボックスのまま公開すると、ポイントだけ引かれて何も届かないので絶対にしないこと
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=

# --- Appwrite Storage（記事の画像） ---
# 空のままだとローカルディスク（server/uploads）に保存される。開発中はそれで足りる。
# ⚠️ 本番では必ず設定すること。Herokuのファイルシステムは揮発性で、
#    デプロイや再起動のたびに画像が消える
#
# ⚠️ エンドポイントはリージョンごとに違う。既定値はFRA向けなので、他のリージョンで
#    作った場合は必ず設定する（未設定だと "Project is not accessible in this region"）
#      NYC: https://nyc.cloud.appwrite.io/v1   TOR: https://tor.cloud.appwrite.io/v1
#      FRA: https://fra.cloud.appwrite.io/v1   SGP: https://sgp.cloud.appwrite.io/v1
# ⚠️ APPWRITE_BUCKET_ID は表示名ではなく「Bucket ID」。自動生成だとランダムな文字列になる
# バケットは Any に Read を付け、File security はオフにしておくこと。
# APIキーの Scopes は files.read と files.write の両方が要る
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# --- ここに書かない変数（参考） ---
# 以下は docker-compose.yml で設定済み、または config.py の既定値で足りるため .env には要らない。
# 本番で値を変えたい場合だけ Heroku の Config Vars に入れる。
#
#   FRONTEND_ORIGIN              CORS許可オリジン（本番は https://www.papunto.pe）
#   POINTS_PER_SOL               100 pts = S/ 1
#   MIN_WITHDRAWAL_POINTS        最低換金ポイント（500）
#   ACCESS_TOKEN_EXPIRE_MINUTES  自前JWTの有効期限（10080 = 7日）
#   RELOADLY_SANDBOX             既定true。本番で使うときだけ false にする
#   CPALEAD_USD_TO_POINTS        USD建て報酬のポイント換算レート
#   MAX_REWARD_POINTS            1件の成果で付与できる上限（異常付与の遮断）
#   UPLOAD_MAX_BYTES             画像の上限（既定5MB）
#   LOCAL_UPLOAD_DIR             ローカル保存の置き場所（開発用）
